<div class="pentra chat-card edgeliner">
  <header class="card-header"><h3><i class="fa-solid fa-bolt"></i> {{localize "EDGELINER.Burst.Title"}}</h3></header>
  {{{rollHTML}}}
  <p>{{#if target}}{{localize "EDGELINER.Burst.ResultTarget" rounds=rounds target=target}}{{else}}{{localize "EDGELINER.Burst.Result" rounds=rounds}}{{/if}}</p>
  <div class="card-buttons">
    <button type="button" data-edgeliner-action="burst-disable"><i class="fa-solid fa-plug-circle-xmark"></i> {{localize "EDGELINER.Burst.ChooseButton"}}</button>
  </div>
</div>
