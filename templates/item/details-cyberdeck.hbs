<section class="item-details">
  <div class="form-group-row">
    <div class="form-group"><label>{{localize "PENTRA.Trait.evasion"}}</label><input type="number" name="system.evasion" value="{{system.evasion}}"></div>
    <div class="form-group"><label>AR</label><input type="number" name="system.armor" value="{{system.armor}}" min="0"></div>
  </div>
  <div class="form-group">
    <label>{{localize "EDGELINER.Deck.Damage"}}</label>
    <div class="form-fields">
      <input type="number" name="system.wounds" value="{{system.wounds}}" min="0">
      <select name="system.increment">{{selectOptions options.increments selected=system.increment localize=true}}</select>
    </div>
  </div>
  <div class="form-group-row">
    <div class="form-group"><label>{{localize "EDGELINER.Deck.Memory"}}</label><select name="system.memory" data-dtype="Number">{{selectOptions options.memory selected=system.memory}}</select></div>
    <div class="form-group"><label>{{localize "EDGELINER.Deck.Modules"}}</label><input type="number" name="system.modules" value="{{system.modules}}" min="0"></div>
  </div>
  <div class="form-group">
    <label>{{localize "EDGELINER.Deck.Range"}}</label>
    <select name="system.range">{{selectOptions options.deckRanges selected=system.range localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Trait.health"}}</label>
    <div class="form-fields">
      <input type="number" name="system.health.value" value="{{system.health.value}}" min="0"> /
      <input type="number" name="system.health.max" value="{{system.health.max}}" min="0">
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "EDGELINER.Deck.ArmorDie"}}</label>
    <select name="system.durability">
      <option value="" {{#unless (ne system.durability null)}}selected{{/unless}}>{{localize "PENTRA.Armor.DurabilityUnset"}}</option>
      {{selectOptions options.usageDice selected=system.durability}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "EDGELINER.Deck.InUse"}}</label>
    <input type="checkbox" name="system.equipped" {{checked system.equipped}}>
  </div>
  <p class="hint">{{localize "EDGELINER.Deck.ItemHint"}}</p>
  {{> "systems/pentra-core-foundry-vtt/templates/item/physical.hbs"}}
</section>
